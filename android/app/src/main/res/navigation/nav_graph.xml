    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.quickkart.app.fragments.HomeFragment"
        android:label="Home" />

    <fragment
        android:id="@+id/navigation_products"
        android:name="com.quickkart.app.fragments.ProductsFragment"
