<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_success_background">

    <!-- Confetti Container (for animated particles) -->
    <FrameLayout
        android:id="@+id/confettiContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Success Icon -->
        <ImageView
            android:id="@+id/successIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_success_check"
            android:contentDescription="Success"
            android:alpha="0"
            android:scaleX="0.5"
            android:scaleY="0.5" />

        <!-- Hurray Text -->
        <TextView
            android:id="@+id/hurrayText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="🎉 Hurray!"
            android:textSize="36sp"
            android:textColor="#16A34A"
            android:textStyle="bold"
            android:alpha="0"
            android:translationY="30dp" />

        <!-- Success Title -->
        <TextView
            android:id="@+id/successTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Order Placed Successfully!"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:gravity="center"
            android:alpha="0"
            android:translationY="30dp" />

        <!-- Success Message -->
        <TextView
            android:id="@+id/successMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Thank you for shopping with us!\nYou will receive a confirmation email soon."
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:alpha="0"
            android:translationY="30dp" />

        <!-- Order ID -->
        <TextView
            android:id="@+id/orderIdText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="12dp"
            android:background="@drawable/rounded_surface"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:alpha="0"
            android:translationY="30dp"
            tools:text="Order ID: #QK-123456" />

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Continue Shopping Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueShoppingButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Continue Shopping"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:backgroundTint="#16A34A"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_home"
            app:iconGravity="textStart"
            app:iconTint="@color/white"
            android:alpha="0"
            android:translationY="30dp" />

        <!-- View Orders Button (Secondary) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/viewOrdersButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="View My Orders"
            android:textSize="16sp"
            android:textColor="#16A34A"
            app:cornerRadius="12dp"
            app:strokeColor="#16A34A"
            app:strokeWidth="2dp"
            app:icon="@drawable/ic_package"
            app:iconGravity="textStart"
            app:iconTint="#16A34A"
            android:alpha="0"
            android:translationY="30dp" />

    </LinearLayout>

</FrameLayout>
